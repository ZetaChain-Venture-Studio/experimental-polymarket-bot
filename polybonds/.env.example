# ===========================================
# POLYMARKET API CREDENTIALS
# ===========================================
# Get private key from: Polymarket.com → Cash → ⋮ → Export Private Key
# Remove the '0x' prefix if present
POLYMARKET_PRIVATE_KEY=your_64_char_hex_private_key_here

# Your Polymarket wallet address (the one shown on your profile)
POLYMARKET_FUNDER_ADDRESS=0xYourPolygonWalletAddress

# Polygon Mainnet Chain ID (don't change)
POLYMARKET_CHAIN_ID=137

# Signature type: 0=EOA/MetaMask, 1=Email/Magic wallet, 2=Gnosis Safe
POLYMARKET_SIGNATURE_TYPE=0

# ===========================================
# STRATEGY PARAMETERS
# ===========================================
# Minimum probability to consider (0.98 = 98%)
MIN_PROBABILITY=0.98

# Maximum probability (avoid 99.9% - likely already settling)
MAX_PROBABILITY=0.995

# Minimum 24h trading volume in USD
MIN_VOLUME_24H=5000

# Maximum USD to invest per market
MAX_POSITION_SIZE_USD=100

# Maximum % of portfolio per single market (0.05 = 5%)
MAX_PORTFOLIO_ALLOCATION_PCT=0.05

# Stop-loss threshold (exit if price drops below this)
STOP_LOSS_THRESHOLD=0.93

# Time filters (in days)
MIN_DAYS_TO_RESOLUTION=1
MAX_DAYS_TO_RESOLUTION=30

# ===========================================
# AUTOMATION
# ===========================================
# Enable automated trading (false = scan only, no trades)
AUTO_TRADING_ENABLED=false

# Scan interval in minutes
SCAN_INTERVAL_MINUTES=5

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=sqlite:///polybonds.db

# ===========================================
# API SERVER
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000

# ===========================================
# OPTIONAL: NOTIFICATIONS
# ===========================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
